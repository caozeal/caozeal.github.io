<% if (page.total > 1){ %>
  <nav aria-label="文章分页">
    <span class="pagination" id="pagination">
      <%- paginator({
        prev_text: '<i class="iconfont icon-arrowleft" aria-hidden="true"></i><span class="sr-only">上一页</span>',
        next_text: '<i class="iconfont icon-arrowright" aria-hidden="true"></i><span class="sr-only">下一页</span>',
        mid_size: 2,
        end_size: 1,
        format: `${config.pagination_dir}/%d/${theme.scroll_down_arrow.scroll_after_turning_page ? '#board' : ''}`,
        escape: false
      }) %>
    </span>
  </nav>
<% } %>
